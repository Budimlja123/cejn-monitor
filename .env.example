# Kopiraj u .env za lokalno testiranje (ne commituje se — u .gitignore je).
# .env se automatski ucitava (dotenv) pri `npm start` / `npm run dry`.
#
# Slanje ide preko Brevo SMTP-a (besplatno 300 mejlova/dan, salje na bilo koju adresu).
# Kredencijale nadjes u Brevo panelu: SMTP & API -> SMTP.
#   SMTP_USER = "Login" iz tog panela (tvoj Brevo nalog / login)
#   SMTP_PASS = generisani SMTP kljuc (dugme "Generate a new SMTP key")
#   MAIL_FROM = verifikovani posiljalac (Senders & IP -> Senders; klikni link u mejlu da ga potvrdis)
#   MAIL_TO   = adresa NA koju stizu obavjestenja (bilo koja)
SMTP_USER=tvoj-brevo-login@primjer.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=CEJN Monitor <verifikovani@primjer.com>
MAIL_TO=radule1607@gmail.com

# opciono (vec podrazumijevano za Brevo):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# opciono: koliko najnovijih tendera pregledati po pokretanju (default 300)
# MAX_ITEMS=300
